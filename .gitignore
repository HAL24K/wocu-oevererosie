# Byte-compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment and package files
.env
.venv/
env/
venv/
*.egg-info/
*.egg

# Log files
*.log
*.out
*.err

# OS-generated files
.DS_Store
Thumbs.db

# Data files
*.csv
*.tsv
*.xls
*.xlsx
*.parquet
*.hdf5
*.h5
*.feather
*.pickle
*.pkl
*.json
*.zip
*.tar
*.gz
*.bz2
*.7z
*.npz
*.npy
*.sqlite

# Model files
*.h5
*.ckpt
*.pt
*.onnx
*.sav

# Large raw or intermediate files
/data/
*.tmp

# Results or output directories
results/
output/
plots/
figures/

# Cache files
.cache/
*.ipynb_cache

# Archived notebooks are tracked deliberately — an archive git cannot see is
# just clutter. See notebooks/README.md.

# Model artifacts (generated by notebooks)
artifacts/

# Coverage, test and tooling caches
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
coverage.xml
pytest.xml

# Documents and raster images — keep binaries out of the repo.
# Notebook outputs embed images as base64 inside .ipynb and are unaffected.
# To commit one deliberately: git add -f <file>
*.pdf
*.png
*.jpg
*.jpeg
*.gif
