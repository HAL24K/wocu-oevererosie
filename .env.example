# ============================================
# Backend Configuration
# ============================================

# Environment
ENVIRONMENT=development

# Data directories (Docker paths)
BACKEND_DATA_DIR=/app/data
BACKEND_SRC_DIR=/app/src

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# ============================================
# Geospatial Configuration
# ============================================

# Coordinate Reference Systems
SOURCE_EPSG=28992  # RD New (Dutch national grid)
TARGET_EPSG=4326   # WGS84 (for web maps)

# Data Processing Parameters
BUFFER_DISTANCE_M=100.0
SIMPLIFY_TOLERANCE=0.5

# ============================================
# Frontend Configuration
# ============================================

# API URL (leave empty for same-origin)
VITE_API_URL=

# Feature flags
VITE_ENABLE_ML_PREDICTIONS=true

# Map defaults (Netherlands)
VITE_MAP_DEFAULT_LAT=52.0
VITE_MAP_DEFAULT_LNG=5.0
VITE_MAP_DEFAULT_ZOOM=7

# ============================================
# Docker Development
# ============================================

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173
